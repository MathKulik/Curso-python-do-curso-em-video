    "from datetime import date\n",
    "ano=int(input('me fala o ano q nasceu: '))\n",
    "id=date.today().year-ano\n",
    "if id<=9:\n",
    "    print('mirim')\n",
    "elif id<=14:\n",
    "    print('infantil')\n",
    "elif id<=19:\n",
    "    print('júnior')\n",
    "elif id<=25:\n",
    "    print('sênior')\n",
    "else:\n",
    "    print('master')\n"
   ]
  }
