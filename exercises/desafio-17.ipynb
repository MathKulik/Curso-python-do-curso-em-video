    "a = float(input('me fala o cateto oposto'))\n",
    "b = float(input('me fala o cateto adjacente'))\n",
    "h = sqrt(a**2+b**2) #existe um modulo exclusivo para hipotenusa\n",
    "print('o seu oposto é {} e o seu adjacente é {} e isso da {}'.format(a,b,h))\n"
   ]
