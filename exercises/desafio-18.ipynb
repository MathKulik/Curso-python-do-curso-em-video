   "source": [
    "from math import sin, cos, tan, radians\n",
    "a = int(input('me fala o angulo'))\n",
    "sn = sin(radians(a))\n",
    "cs = cos(radians(a))\n",
    "tn = tan(radians(a))\n",
    "print('o se angulo é {} logo o seu seno é {:.2f}, seu cosseno é {:.2f} e a sua tangente é {:.2f}'.format(a, sn, cs,tn))\n"
   ]
  }
