   "source": [
    "from datetime import date\n",
    "ano=int(input('me escreva o ano que nasceu: '))\n",
    "id=date.today().year-ano\n",
    "if id<18:\n",
    "    fal=18-id\n",
    "    print(f'ainda faltando {fal} anos')\n",
    "elif id==18:\n",
    "    print('ta na hora')\n",
    "else:\n",
    "    fal=id-18\n",
    "    print(f'ja se passaram {fal} anos do seu alistamento')\n"
   ]
  }
